{
  "name": "dovetab",
  "description": "Bookmarks on your new tab. Fast, private, open source.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/k2so-dev/dovetab",
  "repository": "github:k2so-dev/dovetab",
  "bugs": "https://github.com/k2so-dev/dovetab/issues",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "icons": "node scripts/build-icons.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare",
    "ext-icons": "node scripts/build-ext-icons.ts",
    "e2e": "wxt build && node tests/e2e/flows.ts",
    "shots": "wxt build && node tests/e2e/shots.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "vue": "3.6.0-rc.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "6.0.9",
    "happy-dom": "20.14.5",
    "lucide-static": "1.48.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.2",
    "vue-tsc": "3.3.11",
    "wxt": "0.21.4"
  }
}
